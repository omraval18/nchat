{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "DATABASE_URL",
    "HOSTNAME",
    "NCHAT_ACCESS_TOKEN_TTL_SECONDS",
    "NCHAT_HOME",
    "NCHAT_JWT_SECRET",
    "NCHAT_REFRESH_TOKEN_TTL_DAYS",
    "NCHAT_SERVER_PORT",
    "NCHAT_SERVER_URL",
    "USER"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
